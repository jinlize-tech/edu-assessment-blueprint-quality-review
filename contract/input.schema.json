{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jinlize.tech/education/JLZ-EDU-SK-085/input.schema.json",
  "title": "测评蓝图与试卷质量审查输入契约",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "data_status",
    "contains_sensitive_data",
    "assessment_purpose",
    "exam_paper",
    "answer_key",
    "learning_objectives",
    "knowledge_points",
    "duration",
    "student_level"
  ],
  "properties": {
    "contract_version": {
      "const": "1.2.0"
    },
    "data_status": {
      "type": "string",
      "enum": [
        "confirmed",
        "partially_confirmed",
        "unconfirmed"
      ],
      "description": "输入资料的确认状态"
    },
    "contains_sensitive_data": {
      "type": "boolean"
    },
    "requested_output_language": {
      "type": "string",
      "enum": [
        "zh-CN",
        "en"
      ],
      "default": "zh-CN"
    },
    "assessment_purpose": {
      "title": "测评用途",
      "description": "单元诊断、期中期末或分层",
      "type": "string",
      "minLength": 1
    },
    "exam_paper": {
      "title": "试卷与题目",
      "description": "完整题面",
      "type": "string",
      "minLength": 1
    },
    "answer_key": {
      "title": "答案与评分标准",
      "description": "包括分值和评分锚点",
      "type": "string",
      "minLength": 1
    },
    "learning_objectives": {
      "title": "学习目标",
      "description": "测评需要覆盖的目标",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "knowledge_points": {
      "title": "知识点与课时",
      "description": "知识点、课时和重要度",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "duration": {
      "title": "考试时长",
      "description": "分钟",
      "type": "integer",
      "minimum": 0
    },
    "student_level": {
      "title": "学生群体",
      "description": "年级、班型和基础范围",
      "type": "string",
      "minLength": 1
    }
  }
}
